{
  "name": "@runalongside/js",
  "version": "0.1.0",
  "description": "Browser SDK for Alongside: sends visitor events and renders proactive chat invitations and conversations.",
  "keywords": [
    "alongside",
    "analytics",
    "chat",
    "sdk",
    "browser"
  ],
  "license": "MIT",
  "homepage": "https://github.com/alongside-organization/alongside-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alongside-organization/alongside-js.git"
  },
  "bugs": "https://github.com/alongside-organization/alongside-js/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts tests/delivery/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "prettier": "3.10.1",
    "typescript": "^5.9.3"
  }
}
